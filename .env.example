# Database Configuration
DB_HOST="localhost"
DB_PORT="5432"
DB_USER=""
DB_PASSWORD=""
DB_NAME="catatan-pengeluaran"

# Prisma requires URL format (composed from DB vars above)
DATABASE_URL="postgresql://user:password@localhost:5432/catatan-pengeluaran"

NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OneSignal (https://dashboard.onesignal.com) — Web Push
NEXT_PUBLIC_ONESIGNAL_APP_ID=""
ONESIGNAL_REST_API_KEY=""

# SMTP — Email notifikasi (Gmail: pakai App Password, bukan password akun)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Vercel Cron
CRON_SECRET=""
